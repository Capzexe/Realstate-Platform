{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "capzexe/verisale",
    "type": "project",
    "description": "A Laravel property-history app with searchable records and printable reports.",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10",
        "stripe/stripe-php": "^19.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "test": ["@php artisan config:clear --ansi", "@php artisan test"],
        "format": "@php vendor/bin/pint",
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
    },
    "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
