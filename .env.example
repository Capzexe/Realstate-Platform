APP_NAME=VeriSale
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_LOCALE=lv
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=1440
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Simulated checkout for local development only; production ignores this switch.
DEMO_PAYMENTS=true

# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-real-domain.
# Leave empty for direct TLS. Set only the exact IPs/CIDRs of your own reverse proxy.
TRUSTED_PROXIES=

# Optional: real reports use Stripe checkout. There is no fake payment fallback.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local mail is logged, not delivered. Set MAIL_MAILER=smtp for real delivery.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_EMAIL=info@verisale.ai
