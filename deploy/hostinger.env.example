APP_NAME=VeriSale
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_LOCALE=lv
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# Set the absolute path OUTSIDE public_html on your own account.
DB_DATABASE=/home/ACCOUNT/domains/your-domain.example/verisale/database/database.sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=1440
CACHE_STORE=file
QUEUE_CONNECTION=sync
DEMO_PAYMENTS=false
TRUSTED_PROXIES=

# Use Stripe sandbox/test credentials for a publicly labelled portfolio demo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

MAIL_MAILER=smtp
# Copy the exact host/port/scheme from your email provider, not from a guess.
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_EMAIL=
